# 完全な接続URL、または個別の接続設定のどちらかを使用します。
JVDATA_BRIDGE_MCP_DATABASE_URL=
JVDATA_BRIDGE_MCP_DB_HOST=127.0.0.1
JVDATA_BRIDGE_MCP_DB_PORT=5432
JVDATA_BRIDGE_MCP_DB_NAME=jvdata
JVDATA_BRIDGE_MCP_DB_USER=
JVDATA_BRIDGE_MCP_DB_PASSWORD=
JVDATA_BRIDGE_MCP_SSLMODE=disable

# 接続プールとクエリの安全性に関する上限。
JVDATA_BRIDGE_MCP_POOL_SIZE=5
JVDATA_BRIDGE_MCP_MAX_OVERFLOW=5
JVDATA_BRIDGE_MCP_POOL_TIMEOUT_SECONDS=10
JVDATA_BRIDGE_MCP_CONNECT_TIMEOUT_SECONDS=5
JVDATA_BRIDGE_MCP_COMMAND_TIMEOUT_SECONDS=60
JVDATA_BRIDGE_MCP_MAX_ROWS=200
